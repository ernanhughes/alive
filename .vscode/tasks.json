            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Test: current file",
            "detail": "Run the open test file with pytest.",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "pytest",
                "-q",
                "--color=no",
                "${relativeFile}"
