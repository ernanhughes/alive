            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$pytest"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
