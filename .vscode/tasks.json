{
    "version": "2.0.0",
    "problemMatchers": [
        {
            "name": "ruff",
            "owner": "ruff",
            "fileLocation": [
                "relative",
                "${workspaceFolder}"
            ],
            "pattern": {
                "regexp": "^(.+?):(\\d+):(\\d+): (.*)$",
                "file": 1,
                "line": 2,
                "column": 3,
                "message": 4
            }
        },
        {
            "name": "pytest",
            "owner": "pytest",
            "fileLocation": [
                "relative",
                "${workspaceFolder}"
            ],
            "pattern": {
                "regexp": "^(?:FAILED|ERROR) ([^:]+)(?:::\\S+)? - (.*)$",
                "file": 1,
                "message": 2
            }
        },
        {
            "name": "alive-uvicorn",
            "owner": "alive-uvicorn",
            "pattern": {
                "regexp": "^\\u0000$"
            },
            "background": {
                "activeOnStart": true,
                "beginsPattern": "Started server process",
                "endsPattern": "Application startup complete"
            }
        },
        {
            "name": "alive-vite",
            "owner": "alive-vite",
            "pattern": {
                "regexp": "^\\u0000$"
            },
            "background": {
                "activeOnStart": true,
                "beginsPattern": "VITE v",
                "endsPattern": "Local:\\s+http://127\\.0\\.0\\.1:5173"
            }
        }
    ],
    "inputs": [
        {
            "id": "migrationMessage",
            "type": "promptString",
            "description": "Alembic migration message",
            "default": "describe schema change"
        },
        {
            "id": "pytestTarget",
            "type": "promptString",
            "description": "pytest file or directory",
            "default": "tests"
        },
        {
            "id": "archivePath",
            "type": "promptString",
            "description": "Evidence archive directory to verify",
            "default": "archives/ALIVE-14-R1"
        },
        {
            "id": "dockerToken",
            "type": "promptString",
            "description": "ALIVE_API_TOKEN for the composed app (use the value from .env, or the compose default)",
            "default": "",
            "password": true
        }
    ],
    "tasks": [
        {
            "label": "Setup: Python dependencies (uv sync)",
            "detail": "Install locked backend and development dependencies with uv.",
            "type": "shell",
            "command": "uv",
            "args": [
                "sync",
                "--locked"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Setup: dashboard dependencies (npm ci)",
            "detail": "Install the locked dashboard dependencies.",
            "type": "shell",
            "command": "npm",
            "windows": {
                "command": "npm.cmd"
            },
            "args": [
                "ci"
            ],
            "options": {
                "cwd": "${workspaceFolder}/dashboard"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Setup: local state directory",
            "detail": "Create the ignored .alive directory used by the SQLite fallback, token and evidence.",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "-c",
                "from pathlib import Path; Path('.alive').mkdir(parents=True, exist_ok=True)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: upgrade head",
            "detail": "Apply all Alembic migrations to the configured database.",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "alembic",
                "upgrade",
                "head"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Setup: generate API token",
            "detail": "Print a random URL-safe token to paste into ALIVE_API_TOKEN in .env.",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "-c",
                "import secrets; print(secrets.token_urlsafe(32))"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup: bootstrap",
            "detail": "uv sync --locked, npm ci, then migrate. Copy .env.example to .env first.",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Setup: Python dependencies (uv sync)",
                "Setup: dashboard dependencies (npm ci)",
                "Setup: local state directory",
                "DB: upgrade head"
            ],
            "problemMatcher": []
        },
        {
            "label": "Dev: full stack (Windows scripts/dev.ps1)",
            "detail": "Migrate, then launch hidden backend and Vite processes. Stop with the Dev: stop task.",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/dev.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Dev: backend (uvicorn)",
            "detail": "Foreground backend on http://127.0.0.1:8000 with API docs at /docs.",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "uvicorn",
                "alive.app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [
                "$alive-uvicorn"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Dev: dashboard (Vite)",
            "detail": "Foreground Vite server on http://127.0.0.1:5173.",
            "type": "shell",
            "command": "npm",
            "windows": {
                "command": "npm.cmd"
            },
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/dashboard"
            },
            "isBackground": true,
            "problemMatcher": [
                "$alive-vite"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Dev: stop (Windows scripts/stop.ps1)",
            "detail": "Stop only the backend and Vite processes recorded by scripts/dev.ps1.",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/stop.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Dev: show local token",
            "detail": "Print the generated .alive/token for the dashboard. Never share this value.",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "-c",
                "from pathlib import Path; p = Path('.alive/token'); print(p.read_text().strip() if p.exists() else 'No .alive/token; set ALIVE_API_TOKEN in .env')"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: current revision",
            "detail": "Show the database revision currently applied.",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "alembic",
                "current"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "DB: history",
