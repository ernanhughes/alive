# Copy to .env (ignored), then run scripts/init.ps1 to create a private local token.
# Leave ALIVE_API_TOKEN unset here; the init script adds it and keeps .alive/token in sync.
# ALIVE_API_TOKEN=
DATABASE_URL=postgresql+asyncpg://alive:REPLACE_ME@localhost:5432/alive
ALIVE_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ALIVE_BROWSER_ORIGINS=["http://127.0.0.1:8000"]
ALIVE_BROWSER_AVAILABLE=true
ALIVE_EXPERIMENTS_ENABLED=false
ALIVE_HEARTBEAT_SECONDS=10
ALIVE_PI_COMMAND=["pi"]
ALIVE_PI_PROVIDER=
ALIVE_PI_MODEL=
ALIVE_META_URL=
ALIVE_META_MODEL=muse-spark-1.3-contributor
ALIVE_META_BASE_URL=https://api.meta.ai/v1
ALIVE_META_API_KEY=
ALIVE_META_TIMEOUT=30
ALIVE_META_MAX_OUTPUT=1536
# Supported model roles: observer, proposer, critic. Empty means one pinned Meta model.
ALIVE_ROLE_MODELS={}
ALIVE_EMBEDDING_ENABLED=false
ALIVE_EMBEDDING_PATH=.alive/models/minilm
# Optional local Ollama discovery. The Pi agent runner uses a detected chat model; the memory
# index keeps the pinned 384-dimensional MiniLM model. Empty disables the probe.
ALIVE_OLLAMA_URL=
ALIVE_OLLAMA_CHAT_MODEL=
ALIVE_COGNITIVE_PROVIDER=mock

# --- Docker deployment (ALIVE-DOCKER-01) ---
# Compose provides DATABASE_URL, origins and demo mode automatically; only set
# these to override the safe local defaults. All values below are consumed by
# compose.yaml / the container entrypoint — no new application variables.
# POSTGRES_DB=alive
# POSTGRES_USER=alive
# POSTGRES_PASSWORD=change-me-for-local-use
# ALIVE_API_TOKEN is required for Docker. Run scripts/init.ps1 in this checkout;
# the same token is used by the local app and the composed app. Never expose it publicly.
# ALIVE_DEMO_MODE=true loads idempotent fixture content into a fresh database.
# Restarts never duplicate or overwrite existing data.
# ALIVE_DEMO_MODE=true
# Host port for the composed app. Keep 8000 for the Chrome extension demo (the extension is
# built for port 8000); other values move the dashboard but break the extension.
# ALIVE_HOST_PORT=8000
# Optional: build the dashboard against an explicit API origin instead of the
# default same-origin wiring (only needed behind custom reverse proxies).
# VITE_ALIVE_API_BASE=
# Docker-only Pi overrides. Host ALIVE_PI_* values are deliberately not copied into the
# container. Leave these empty to auto-detect a small Ollama chat model on the host.
# ALIVE_DOCKER_PI_PROVIDER=
# ALIVE_DOCKER_PI_MODEL=
# Optional host Ollama endpoint; the compose default is already host.docker.internal:11434.
# ALIVE_OLLAMA_URL=http://host.docker.internal:11434
# ALIVE_OLLAMA_CHAT_MODEL=qwen2.5:0.5b
