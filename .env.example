# Copy to .env (ignored). Generate a token with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
ALIVE_API_TOKEN=replace-with-a-long-random-local-token
DATABASE_URL=postgresql+asyncpg://alive:REPLACE_ME@localhost:5432/alive
ALIVE_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ALIVE_BROWSER_ORIGINS=["http://127.0.0.1:8000"]
ALIVE_HEARTBEAT_SECONDS=10
ALIVE_PI_COMMAND=["pi"]
ALIVE_PI_PROVIDER=
ALIVE_PI_MODEL=
ALIVE_META_URL=
ALIVE_META_MODEL=muse-spark-1.3
ALIVE_META_BASE_URL=https://api.meta.ai/v1
ALIVE_META_API_KEY=
ALIVE_META_TIMEOUT=30
ALIVE_META_MAX_OUTPUT=1536
# Supported model roles: observer, proposer, critic. Empty means one pinned Meta model.
ALIVE_ROLE_MODELS={}
ALIVE_EMBEDDING_ENABLED=false
ALIVE_EMBEDDING_PATH=.alive/models/minilm
ALIVE_COGNITIVE_PROVIDER=mock
