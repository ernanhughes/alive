{
  "schema_version": 1,
  "name": "pi03c-repository",
  "version": 1,
  "title": "Captured evidence: repository",
  "inputs": {
    "source_ref": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "scoped_sha256": {
      "type": "string"
    },
    "findings": {
      "type": "array"
    },
    "paths": {
      "type": "array"
    }
  },
  "stages": [
    {
      "id": "read",
      "title": "read",
      "type": "deterministic",
      "operation": "repository.inspect",
      "capability_version": "1.1.0",
      "capability_sha256": "f47fb00ba91b3aa66fba20dfadaa57a033950cf8222b2670bb2ea45eb1cb732d",
      "inputs": {
        "source_ref": "$input.source_ref",
        "mode": "read",
        "paths": "$input.paths"
      },
      "depends_on": [],
      "output_schema": {
        "properties": {
          "entries": {
            "type": "array"
          },
          "files": {
            "type": "array"
          },
          "limits_applied": {
            "type": "object"
          },
          "mode": {
            "type": "string"
          },
          "omitted": {
            "type": "array"
          },
          "provenance": {
            "type": "object"
          },
          "scoped_sha256": {
            "type": "string"
          },
          "semantic_status": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string"
          }
        },
        "required": [
          "entries",
          "files",
          "limits_applied",
          "mode",
          "omitted",
          "provenance",
          "scoped_sha256",
          "semantic_status",
          "source_ref",
          "source_sha256"
        ]
      },
      "limits": {
        "timeout_seconds": 30
      }
    },
    {
      "id": "references",
      "title": "references",
      "type": "validation",
      "operation": "evidence.validate_references",
      "capability_version": "1.1.0",
      "capability_sha256": "7c8e509f0741e90118bb58491a98f0a57d10a1698994bf25f2737346ff432c19",
      "inputs": {
        "source_ref": "$input.source_ref",
        "source_sha256": "$input.source_sha256",
        "scoped_sha256": "$input.scoped_sha256",
        "findings": "$input.findings"
      },
      "depends_on": [
        "read"
      ],
      "output_schema": {
        "properties": {
          "records": {
            "type": "object"
          }
        },
        "required": [
          "records"
        ]
      },
      "limits": {
        "timeout_seconds": 30
      }
    },
    {
      "id": "locators",
      "title": "locators",
      "type": "validation",
      "operation": "evidence.verify-locators",
      "capability_version": "1.0.0",
      "capability_sha256": "9b4188d2c65312feb3b724ef41cb1a8a7808eb95e0ab5be35cb1dcf4cf676cfb",
      "inputs": {
        "source_ref": "$input.source_ref",
        "source_sha256": "$input.source_sha256",
        "scoped_sha256": "$input.scoped_sha256",
        "findings": "$input.findings"
      },
      "depends_on": [
        "references"
      ],
      "output_schema": {
        "properties": {
          "records": {
            "type": "object"
          }
        },
        "required": [
          "records"
        ]
      },
      "limits": {
        "timeout_seconds": 30
      }
    },
    {
      "id": "compose",
      "title": "compose",
      "type": "validation",
      "operation": "report.compose",
      "capability_version": "1.0.0",
      "capability_sha256": "625e3b9548c1d276b15695e05380c4a1f0df82280228a6b47a127e2ac51a6757",
      "inputs": {
        "records": "$stage.locators.records"
      },
      "depends_on": [
        "locators"
      ],
      "output_schema": {
        "properties": {
          "assessment": {
            "type": "object"
          },
          "result": {
            "type": "object"
          }
        },
        "required": [
          "assessment",
          "result"
        ]
      },
      "limits": {
        "timeout_seconds": 30
      }
    },
    {
      "id": "record",
      "title": "record",
      "type": "deterministic",
      "operation": "result.record",
      "capability_version": "1.0.0",
      "capability_sha256": "9eb884e56453645356940304b4177f135ba34ae0ba242546aba6ef5b045216ca",
      "inputs": {
        "result": "$stage.compose.result",
        "assessment": "$stage.compose.assessment"
      },
      "depends_on": [
        "compose"
      ],
      "output_schema": {
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ]
      },
      "limits": {
        "timeout_seconds": 30
      }
    }
  ],
  "limits": {
    "max_wall_seconds": 120,
    "max_model_calls": 0,
    "max_total_output_tokens": 0
  }
}
